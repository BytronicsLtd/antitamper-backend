# Server
PORT=4000
DEV=true
LOG_ROUTES=true

# MongoDB
DB_IP=localhost
DB_PORT=27017
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=iot
DB_RS_NAME=rs0

# JWT
SECRET_KEY=your_jwt_secret_key_here

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# SMS (Advanta)
SMS_URL=https://quicksms.advantasms.com/api/services/sendbulk/
SMS_SHORTCODE=BYTRONICS
SMS_USERID=your_userid
SMS_API_KEY=your_api_key
SMS_PARTNER_ID=your_partner_id

# MQTT
MQTT_HOST=your_mqtt_host
MQTT_PORT=1883
MQTT_CUSTOM_NAME=your_broker_name

# Encryption (Legacy AES for other purposes)
AES_KEY=your_32_char_hex_key_here

# M2M Encryption Key (SDK <-> Backend communication)
# Must be 64 hex characters (32 bytes) for AES-256-GCM
# Generate with: openssl rand -hex 32
# IMPORTANT: This key must match the key embedded in the SDK native library
M2M_ENCRYPTION_KEY=

# API Base URL (for local development)
API_BASE_URL=http://localhost:4000/api/v1
